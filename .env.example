# Server-only settings. Copy this file to .env and fill it in. Never commit .env.

# --- Contact form delivery -------------------------------------------------
# Set at least one channel. With none set, /api/contact answers 503 and the page
# falls back to opening the visitor's mail client.

# Email through Resend (https://resend.com). Needs the key and a destination.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Sender. The default is Resend's sandbox address, which can only deliver to the
# email on your own Resend account. Verify a domain there to use your own sender.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Optional: also keep every message in MongoDB (collection: contact_messages).
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=portfolio

# --- Site ------------------------------------------------------------------
# Public URL, used for link-preview tags (og:image must be absolute) and to allow
# browser POSTs from this origin. Leave unset to use the default in routes/__root.jsx.
# VITE_SITE_URL=https://your-domain.example
# SITE_URL=https://your-domain.example
